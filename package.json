{
  "name": "medicerca",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "corepack enable --install-directory node_modules/.bin pnpm",
    "predev": "corepack enable --install-directory node_modules/.bin pnpm",
    "dev": "node --env-file=.env.local node_modules/turbo/bin/turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @medicerca/web test:e2e",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@insforge/cli": "0.2.7",
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2"
  }
}
