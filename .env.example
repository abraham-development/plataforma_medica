# Entorno: development | production
NODE_ENV=development

# Web (los valores NEXT_PUBLIC_* se exponen al navegador)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_INSFORGE_URL=https://your-project.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# API (server only)
PORT=4000
WEB_URL=http://localhost:3000
INSFORGE_URL=https://your-project.us-east.insforge.app
INSFORGE_ANON_KEY=

# Solo para tareas administrativas puntuales; nunca use NEXT_PUBLIC_ en esta clave.
INSFORGE_API_KEY=
